{
  "name": "Feed Sales",
  "dataColors": [
    "#D97706",
    "#059669",
    "#0284C7",
    "#8B5CF6",
    "#F43F5E",
    "#14B8A6"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#059669",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#475569"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#0F172A"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#0F172A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "fontSize": 11
          }
        ],
        "values": [
          {
            "fontSize": 11
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 11
          }
        ],
        "values": [
          {
            "fontSize": 10
          }
        ]
      }
    }
  }
}